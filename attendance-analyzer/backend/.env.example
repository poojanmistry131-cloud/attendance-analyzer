# Copy this file to ".env" in the same folder and fill in your real values.
# .env is loaded automatically by email_service.py — never commit/share it.

# The Gmail address you want to send reminder emails FROM.
GMAIL_ADDRESS=youraddress@gmail.com

# A 16-character Gmail "App Password" (NOT your normal Gmail password).
# Generate one at: Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
